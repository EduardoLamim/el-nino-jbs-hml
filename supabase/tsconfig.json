{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "noUncheckedIndexedAccess": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "allowImportingTsExtensions": true, "skipLibCheck": true, "types": []
  },
  "include": ["functions/**/*.ts"]
}
